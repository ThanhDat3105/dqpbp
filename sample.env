# Server
PORT=5001
NODE_ENV=development

# PostgreSQL (pick one style)
DATABASE_URL=postgresql://dqpbp:dqpbp@localhost:5432/dqpbp

# Knowledge Base (RAG)
KNOWLEDGE_BASE_DIR=knowledge-base
KNOWLEDGE_CHUNKS_TABLE=knowledge_chunks
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=sk

# OR:
DB_HOST=localhost
DB_PORT=5432
DB_USER=dqpbp
DB_PASSWORD=dqpbp
DB_NAME=dqpbp

# Optional for JWT auth routes
JWT_SECRET=your-secret-key

# reCAPTCHA (public registration)
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Registration rate limits (optional overrides)
# REGISTRATION_RATE_WINDOW_MS=3600000
# REGISTRATION_MAX_PER_IP=5
# REGISTRATION_MAX_PER_PHONE=3